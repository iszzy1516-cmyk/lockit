{
  "name": "lockit",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "A zero-knowledge password and secrets vault",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && tsc -p tsconfig.cli.json && vite build",
    "start": "node dist/server/server/index.js",
    "local": "npm run build && node scripts/local.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run build && npm run desktop:prepare && tauri build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.cli.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "libsodium-wrappers-sumo": "^0.7.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sodium-native": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sodium-native": "^2.3.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
