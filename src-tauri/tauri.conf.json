{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lockit",
  "version": "0.1.2",
  "identifier": "com.lockit.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../dist/server/": "server/",
      "../dist/shared/": "shared/",
      "../dist/public/": "public/",
      "sidecar.mjs": "sidecar.mjs"
    },
    "category": "Utility",
    "shortDescription": "A local, zero-knowledge secrets vault"
  }
}
