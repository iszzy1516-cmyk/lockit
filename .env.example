# Generate production values independently; never commit real secrets.
LOCKIT_SHARE_PEPPER=replace-with-at-least-32-random-bytes
LOCKIT_PUBLIC_ORIGIN=https://vault.example.com
LOCKIT_DB_PATH=./data/lockit.db
PORT=3000
# Set true only when the app is reachable exclusively through the trusted proxy.
LOCKIT_TRUST_PROXY=false
